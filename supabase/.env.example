# Copy to supabase/.env.local (local) or supabase/.env.production and fill in.
# NEVER commit the filled-in files (they are git-ignored).

# Envelope private key(s): output of `deno run scripts/generate-api-keys.ts k1`
API_PRIVATE_KEYS={"k1":"<pkcs8-base64url>"}

ANDROID_PACKAGE_NAME=com.arbot.game

# Google Cloud service account with "View financial data" + "Manage orders" in
# Play Console and the Play Integrity API enabled. Paste the JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# off | log | enforce   (use enforce in production)
INTEGRITY_MODE=enforce
# Comma separated base64url SHA-256 of your app signing certificate(s) (Play Console > App integrity)
INTEGRITY_CERT_DIGESTS=
INTEGRITY_REQUIRE_LICENSED=true

# Only true for internal testing with license testers.
ALLOW_TEST_PURCHASES=false

# play-rtdn function (Pub/Sub push authentication)
RTDN_AUDIENCE=https://<project-ref>.supabase.co/functions/v1/play-rtdn
RTDN_PUSH_SERVICE_ACCOUNT=rtdn-push@<gcp-project>.iam.gserviceaccount.com
